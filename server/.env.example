# LEAF Mobility â€” configurazione runtime server (copiare in server/.env).
# Tutte le variabili hanno default sicuri: il file e' opzionale.

# Host/porta del server. SOLO loopback per impostazione predefinita (sicuro).
# Per accettare richieste da DISPOSITIVI ESTERNI (app mobile / WebDashboard) impostare
# LEAF_HOST=0.0.0.0 (tutte le interfacce) o l'IP di LAN: la API pubblica /api/v1 e
# l'endpoint di controllo /__admin__ diventano raggiungibili dalla rete.
# ATTENZIONE: esporre in rete richiede di proteggere /__admin__ con LEAF_ADMIN_TOKEN.
LEAF_HOST=127.0.0.1
LEAF_PORT=8770

# Origini CORS consentite per la API pubblica (client web). "*" = tutte (comodo in
# sviluppo). In rete restringere alle origini note, es:
#   LEAF_CORS_ORIGINS=https://dashboard.leaf.local,https://app.leaf.local
LEAF_CORS_ORIGINS=*

# Rate limiting della API pubblica /api/v1: richieste massime per finestra e per host.
# 0 disabilita il limite. Gli endpoint di controllo /__admin__ non sono limitati.
LEAF_RATE_LIMIT=120
LEAF_RATE_WINDOW_S=60

# Concorrenza: numero di worker uvicorn (1 = singolo processo asyncio).
# ATTENZIONE: tenere 1. uvicorn+FastAPI Ã¨ asincrono e regge gia' molti dispositivi
# in concorrenza su un solo processo. Con piu' worker le sessioni (token/MFA) sono
# in-memory PER-PROCESSO e l'autenticazione si romperebbe tra una richiesta e l'altra.
LEAF_WORKERS=1

# Logging strutturato del runtime: livello minimo (DEBUG/INFO/WARNING/ERROR).
# I log vanno su console e su server/dati/server_app.log con i parametri diagnostici:
#   Timestamp | Modulo | Livello | PID/TID | IP client | request-id | Messaggio
LEAF_LOG_LEVEL=INFO

# Backup automatico: intervallo in secondi e numero di archivi da conservare.
LEAF_BACKUP_AUTO=false
LEAF_BACKUP_INTERVAL_S=900
LEAF_BACKUP_RETENTION=10

# Soglie di allerta hardware per la colorazione delle barre (percentuali).
LEAF_SOGLIA_CPU=85
LEAF_SOGLIA_RAM=85

# --- Persistenza: Cloud Firestore (accesso SOLO server-side, Integration Tier) ---
# Chiave service account per il progetto Cloud REALE (firebase-admin). Percorso
# relativo a server/ o assoluto. La chiave NON e' versionata (server/.gitignore).
LEAF_FIREBASE_CRED=./leaf-mobility-firebase-adminsdk-fbsvc-02a989c86b.json

# Emulatore Firestore per sviluppo/test OFFLINE (host:porta, es. localhost:8080).
# VUOTO = usa il cloud reale con LEAF_FIREBASE_CRED. VALORIZZATO = usa l'emulatore
# SENZA credenziali reali (nessuna risorsa Cloud toccata). Avvio emulatore:
#   firebase emulators:start --only firestore
FIRESTORE_EMULATOR_HOST=

# Chiave AES-256 per la cifratura applicativa dei campi sensibili ðŸ”’ (IIN-4): base64
# di 32 byte. Se VUOTA il DataAccessManager non cifra (sviluppo/test). Generala con:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# La chiave e' un segreto: NON versionarla (gestirla come la chiave service account).
LEAF_AES_KEY=

# --- Email transazionali: invio SMTP (Integration Tier, GatewayEmail, UT.09) ---
# Casella di supporto/mittente e relativa app password Gmail. Se MITTENTE o
# APP_PASSWORD sono VUOTI il gateway email e' DISATTIVATO (no-op): nessun invio reale.
# La app password si genera da Google Account > Sicurezza > Password per le app (16
# caratteri); e' un SEGRETO: NON versionarla (gestirla come la chiave service account).
LEAF_SMTP_HOST=smtp.gmail.com
LEAF_SMTP_PORT=587
LEAF_EMAIL_MITTENTE=support@leafmobility.example.com
LEAF_EMAIL_APP_PASSWORD=
