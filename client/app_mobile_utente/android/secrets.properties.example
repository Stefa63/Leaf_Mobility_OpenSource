# Template versionato. Copiare in secrets.properties e inserire la propria key.
#   cp secrets.properties.example secrets.properties
# La Google Maps API key va creata sulla Google Cloud Console e ristretta per
# package name (com.leafmobility.app_mobile_utente) + SHA-1. TD-01.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
